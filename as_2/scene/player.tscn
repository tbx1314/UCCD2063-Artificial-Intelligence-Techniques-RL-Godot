[sub_resource type="Shader" id="Shader_hp4bs"]
code = "shader_type canvas_item;

// The color you want to change the shirt to.
uniform vec4 shirt_color : source_color = vec4(0.2, 0.5, 1.0, 1.0); // Default blue

// The approximate original base pink of your sprite. 
// Used as a baseline to calculate shadows and highlights correctly.
uniform vec4 reference_pink : source_color = vec4(1.0, 0.64, 0.87, 1.0); 

// Tolerance for the pink hue (allows catching shadows and anti-aliasing).
uniform float hue_tolerance : hint_range(0.0, 0.5) = 0.15;

// Standard GLSL function to convert RGB to HSV
vec3 rgb2hsv(vec3 c) {
	vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
	vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
	vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));

	float d = q.x - min(q.w, q.y);
	float e = 1.0e-10;
	return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

// Standard GLSL function to convert HSV back to RGB
vec3 hsv2rgb(vec3 c) {
	vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
	vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
	return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

void fragment() {
	vec4 tex_color = texture(TEXTURE, UV);
	vec3 current_hsv = rgb2hsv(tex_color.rgb);
	
	vec3 target_hsv = rgb2hsv(shirt_color.rgb);
	vec3 ref_pink_hsv = rgb2hsv(reference_pink.rgb);
	
	// Calculate distance between current pixel's hue and the reference pink hue.
    // We use fract and abs to account for the hue wheel wrapping around at 1.0/0.0.
    float hue_dist = abs(current_hsv.x - ref_pink_hsv.x);
    hue_dist = min(hue_dist, 1.0 - hue_dist);
    
    // Check if the pixel is within our pink hue tolerance
	// Also ensure we aren't recoloring whites/grays (saturation > 0.2) 
	// or black outlines (value > 0.2)
	if (hue_dist < hue_tolerance && current_hsv.y > 0.2 && current_hsv.z > 0.2) {
		
		// Calculate the ratio of the current pixel's shading compared to the reference pink
        float sat_ratio = current_hsv.y / ref_pink_hsv.y;
        float val_ratio = current_hsv.z / ref_pink_hsv.z;
        
        // Apply the new hue
        current_hsv.x = target_hsv.x;
        
        // Apply the new saturation and value, modulated by the original shading ratios
        current_hsv.y = clamp(target_hsv.y * sat_ratio, 0.0, 1.0);
        current_hsv.z = clamp(target_hsv.z * val_ratio, 0.0, 1.0);
        
        // Convert back to RGB and apply
        tex_color.rgb = hsv2rgb(current_hsv);
    }
    
    COLOR = tex_color;
}
"

